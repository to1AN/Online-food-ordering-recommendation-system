<!--
  猜你喜欢 — 基于用户历史行为推荐菜品
  成员B：选餐与个性化推荐模块
-->
<view class="page-guess">

  <!-- ===== 页面头部 ===== -->
  <view class="guess-header">
    <text class="guess-header__title">💝 猜你喜欢</text>
    <text class="guess-header__desc">基于你的口味偏好，为你精选推荐</text>
  </view>

  <!-- ===== 加载中骨架屏 ===== -->
  <view class="guess-skeleton" wx:if="{{loading}}">
    <view class="guess-skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="index">
      <view class="skeleton-line skeleton-img"></view>
      <view class="skeleton-info">
        <view class="skeleton-line skeleton-name"></view>
        <view class="skeleton-line skeleton-reason"></view>
        <view class="skeleton-line skeleton-price"></view>
      </view>
    </view>
  </view>

  <!-- ===== 推荐列表 ===== -->
  <view class="guess-list" wx:if="{{!loading && list.length > 0}}">
    <view
      class="guess-card"
      wx:for="{{list}}"
      wx:key="dish_id"
      data-dish="{{item}}"
      bindtap="onItemTap"
    >
      <!-- 推荐理由标签 -->
      <view class="guess-card__reason-tag" wx:if="{{item.reason}}">
        <text>🎯 {{item.reason}}</text>
      </view>

      <view class="guess-card__body">
        <!-- 菜品图片 -->
        <image
          class="guess-card__image"
          src="{{item.image_url}}"
          mode="aspectFill"
          lazy-load
        />

        <!-- 菜品信息 -->
        <view class="guess-card__info flex-1">
          <text class="guess-card__name">{{item.dish_name}}</text>
          <text class="guess-card__desc text-sm text-secondary text-ellipsis-2" wx:if="{{item.description}}">
            {{item.description}}
          </text>
          <view class="flex-between mt-16">
            <text class="guess-card__price">¥{{item.price}}</text>
            <text class="guess-card__category text-sm text-primary">{{item.category || '美食'}}</text>
          </view>
        </view>

        <!-- 箭头 -->
        <text class="guess-card__arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-icon">🔮</text>
    <text class="empty-text">暂无推荐</text>
    <text class="empty-text text-sm" style="margin-top: 8rpx;">多点点喜欢的菜品，我们就能更懂你</text>
  </view>

</view>
