/**
 * 菜品详情页样式
 */

.page-detail {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 120rpx;
}

/* ===== 大图 ===== */
.detail-image-wrapper {
  position: relative;
  width: 100%;
  height: 500rpx;
}

.detail-image {
  width: 100%;
  height: 100%;
  background-color: #F0F0F0;
}

.detail-back {
  position: absolute;
  top: 60rpx;
  left: 24rpx;
  background-color: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* ===== 信息卡片 ===== */
.detail-card {
  background-color: var(--color-card);
  margin: 16rpx 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
  margin-right: 16rpx;
}

.detail-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-accent);
  flex-shrink: 0;
}

/* 标签 */
.detail-tags {
  flex-wrap: wrap;
}

.detail-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.detail-tag--category {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.detail-tag--stall {
  background-color: #F0F0F0;
  color: var(--color-text-secondary);
}

/* 评分统计 */
.detail-stats {
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
}

.detail-stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

/* 描述 */
.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.detail-description {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  display: block;
}

/* 档口 */
.detail-stall-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ===== 操作按钮 ===== */
.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.action-btn--favorite {
  background-color: #F5F5F5;
  color: var(--color-text-secondary);
}

.action-btn--favorited {
  background-color: #FFF0E8;
  color: var(--color-accent);
}

.action-btn--primary {
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  color: #FFFFFF;
}

/* ===== 选餐成功弹窗 ===== */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.success-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  margin: 0 48rpx;
  width: 500rpx;
}

.success-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 12rpx;
}

.success-dish {
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.success-hint {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 加载 */
.detail-loading {
  font-size: 28rpx;
  color: var(--color-text-light);
}
