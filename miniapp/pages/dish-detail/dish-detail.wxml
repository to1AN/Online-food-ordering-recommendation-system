<!--
  菜品详情页
  成员B：选餐与个性化推荐模块
-->
<view class="page-detail">

  <!-- ===== 加载中 ===== -->
  <view class="detail-loading flex-center" wx:if="{{loading}}" style="height: 100vh;">
    <text>加载中...</text>
  </view>

  <!-- ===== 详情内容 ===== -->
  <block wx:if="{{!loading && dish}}">

    <!-- 大图展示 -->
    <view class="detail-image-wrapper">
      <image
        class="detail-image"
        src="{{dish.image_url}}"
        mode="aspectFill"
      />
      <!-- 返回按钮 -->
      <view class="detail-back" bindtap="onBack">
        <text>← 返回</text>
      </view>
    </view>

    <!-- 基本信息卡片 -->
    <view class="detail-card">
      <view class="flex-between">
        <text class="detail-name">{{dish.dish_name}}</text>
        <text class="detail-price">¥{{dish.price}}</text>
      </view>

      <view class="detail-tags flex-row mt-16">
        <text class="detail-tag detail-tag--category">{{dish.category || '美食'}}</text>
        <text class="detail-tag detail-tag--stall" wx:if="{{dish.stall_name}}">
          📍 {{dish.stall_name}}
        </text>
      </view>

      <!-- 评分信息（如果有） -->
      <view class="detail-stats flex-row mt-24" wx:if="{{dish.avg_score}}">
        <view class="detail-stat">
          <text class="stat-value">{{dish.avg_score}}</text>
          <text class="stat-label">均分</text>
        </view>
        <view class="detail-stat">
          <text class="stat-value">{{dish.praise_count || 0}}</text>
          <text class="stat-label">好评</text>
        </view>
        <view class="detail-stat">
          <text class="stat-value">{{dish.price}}</text>
          <text class="stat-label">元</text>
        </view>
      </view>
    </view>

    <!-- 菜品描述 -->
    <view class="detail-card" wx:if="{{dish.description}}">
      <text class="detail-section-title">📝 菜品描述</text>
      <text class="detail-description mt-16">{{dish.description}}</text>
    </view>

    <!-- 所属档口信息 -->
    <view class="detail-card" wx:if="{{dish.stall_name || dish.merchant_name}}">
      <text class="detail-section-title">🏪 所属档口</text>
      <view class="flex-row mt-16">
        <text class="detail-stall-name">{{dish.stall_name || '未知档口'}}</text>
        <text class="text-light text-sm ml-16" wx:if="{{dish.merchant_name}}">
          商户：{{dish.merchant_name}}
        </text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="detail-actions">
      <button class="action-btn action-btn--favorite {{isFavorited ? 'action-btn--favorited' : ''}}" bindtap="onToggleFavorite">
        <text>{{isFavorited ? '❤️ 已收藏' : '🤍 收藏'}}</text>
      </button>
      <button class="action-btn action-btn--primary" bindtap="onSelectDish">
        <text>🎯 就选这个</text>
      </button>
    </view>

    <!-- 选餐成功弹窗 -->
    <view class="success-overlay" wx:if="{{showSuccess}}" bindtap="onCloseSuccess">
      <view class="success-card" catchtap="">
        <text class="success-emoji">🎉</text>
        <text class="success-title">已记录选餐</text>
        <text class="success-dish">{{dish.dish_name}}</text>
        <text class="success-hint">稍后记得去评分哦~</text>
        <button class="btn-primary mt-32" bindtap="onCloseSuccess">知道了</button>
      </view>
    </view>

  </block>

  <!-- ===== 空/错误状态 ===== -->
  <view class="empty-state" wx:if="{{!loading && !dish}}" style="height: 100vh;">
    <text class="empty-icon">😕</text>
    <text class="empty-text">菜品信息加载失败</text>
    <button class="btn-outline mt-32" bindtap="onBack">返回首页</button>
  </view>

</view>
