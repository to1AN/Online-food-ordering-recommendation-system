/**
 * 猜你喜欢样式
 */

.page-guess {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

/* ===== 头部 ===== */
.guess-header {
  background: linear-gradient(135deg, #FFA502, #FF6B35);
  padding: 40rpx 32rpx 48rpx;
  text-align: center;
}

.guess-header__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.guess-header__desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ===== 推荐列表 ===== */
.guess-list {
  padding: 24rpx;
}

.guess-card {
  background-color: var(--color-card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.15s;
}

.guess-card:active {
  transform: scale(0.98);
}

/* 推荐理由标签 */
.guess-card__reason-tag {
  background: linear-gradient(135deg, #FFF0E8, #FFE8D6);
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  border-bottom: 1rpx solid var(--color-border);
}

/* 卡片主体 */
.guess-card__body {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.guess-card__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background-color: #F0F0F0;
  flex-shrink: 0;
}

.guess-card__info {
  margin-left: 20rpx;
  min-width: 0;
}

.guess-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 8rpx;
}

.guess-card__desc {
  display: block;
  margin-bottom: 12rpx;
}

.guess-card__price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.guess-card__category {
  background-color: var(--color-primary-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.guess-card__arrow {
  font-size: 48rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ===== 骨架屏 ===== */
.guess-skeleton {
  padding: 24rpx;
}

.guess-skeleton-card {
  display: flex;
  align-items: center;
  background-color: var(--color-card);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.skeleton-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.skeleton-info {
  flex: 1;
  margin-left: 20rpx;
}

.skeleton-name {
  width: 70%;
  height: 32rpx;
  margin-bottom: 16rpx;
}

.skeleton-reason {
  width: 90%;
  height: 24rpx;
  margin-bottom: 12rpx;
}

.skeleton-price {
  width: 35%;
  height: 28rpx;
}

.skeleton-img,
.skeleton-name,
.skeleton-reason,
.skeleton-price {
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 6rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
