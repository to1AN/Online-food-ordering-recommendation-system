/**
 * 今日好评榜样式
 */

.page-praise {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

/* ===== 头部 ===== */
.praise-header {
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  padding: 40rpx 32rpx 48rpx;
  text-align: center;
}

.praise-header__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.praise-header__desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 排行榜列表 ===== */
.praise-list {
  padding: 16rpx 24rpx;
}

.praise-item {
  display: flex;
  align-items: center;
  background-color: var(--color-card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s;
}

.praise-item:active {
  transform: scale(0.98);
}

/* 排名 */
.praise-item__rank {
  width: 72rpx;
  text-align: center;
  flex-shrink: 0;
}

.rank-medal {
  font-size: 48rpx;
}

.rank-number {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-light);
}

/* 图片 */
.praise-item__image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #F0F0F0;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 信息 */
.praise-item__info {
  margin-left: 20rpx;
  min-width: 0;
}

.praise-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 6rpx;
}

.praise-item__price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* 评分 */
.praise-item__score {
  flex-shrink: 0;
  text-align: center;
  padding-left: 16rpx;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-accent);
  line-height: 1;
}

.score-label {
  font-size: 20rpx;
  color: var(--color-accent);
}

.star-row {
  display: flex;
  justify-content: center;
  margin-top: 6rpx;
}

.star-item {
  font-size: 22rpx;
  color: var(--color-warning);
}

/* ===== 骨架屏 ===== */
.praise-skeleton {
  padding: 24rpx;
}

.praise-skeleton-item {
  display: flex;
  align-items: center;
  background-color: var(--color-card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.skeleton-rank {
  width: 48rpx;
  height: 48rpx;
}

.skeleton-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.skeleton-info {
  flex: 1;
  margin-left: 20rpx;
}

.skeleton-name {
  width: 60%;
  height: 30rpx;
  margin-bottom: 16rpx;
}

.skeleton-score {
  width: 40%;
  height: 24rpx;
}

.skeleton-rank,
.skeleton-img,
.skeleton-name,
.skeleton-score {
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 6rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
