/**
 * 个人中心 — 样式
 */

.mine-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

/* ===== 未登录卡片 ===== */
.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  background-color: #FFFFFF;
  margin: 24rpx;
  border-radius: 24rpx;
}

.login-avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
}

.login-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

/* ===== 个人信息卡片 ===== */
.profile-card {
  position: relative;
  margin: 0;
  overflow: hidden;
}

.profile-bg {
  height: 200rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
}

.profile-content {
  display: flex;
  align-items: center;
  padding: 0 32rpx 32rpx;
  margin-top: -60rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  background-color: #F0F0F0;
  flex-shrink: 0;
}

.profile-info {
  margin-left: 24rpx;
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.profile-edit-icon {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.profile-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* ===== 统计栏 ===== */
.stats-row {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B35;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background-color: #EEE;
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: 2rpx solid #EEE;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-active {
  color: #FF6B35;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: #FF6B35;
  border-radius: 2rpx;
}

.tab-content {
  background-color: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 0 0 16rpx 16rpx;
  min-height: 200rpx;
}

/* ===== 菜品列表项 ===== */
.dish-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #F0F0F0;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.dish-price {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-top: 6rpx;
  display: block;
}

.dish-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.dish-action {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
}

.action-text {
  font-size: 24rpx;
}

.remove-text {
  color: #FF4757;
}

.liked {
  color: #FF4757;
}

.edit-text {
  color: #FF6B35;
}

/* ===== 星级显示 ===== */
.stars-display {
  margin-top: 8rpx;
}

.star {
  font-size: 24rpx;
  color: #DDD;
  margin-right: 4rpx;
}

.star-on {
  color: #FFA502;
}

/* ===== 退出登录 ===== */
.logout-section {
  padding: 48rpx 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #FFFFFF;
  color: #FF4757;
  font-size: 30rpx;
  border: 2rpx solid #FF4757;
  border-radius: 44rpx;
}

/* ===== 弹窗 ===== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.popup-box {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.popup-input {
  border: 2rpx solid #EEE;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.popup-btns {
  display: flex;
  gap: 24rpx;
}

.popup-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  text-align: center;
}

.cancel-btn {
  background-color: #F5F5F5;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #FFFFFF;
}

/* ===== 评分弹窗 ===== */
.rating-stars {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}

.rating-star {
  font-size: 56rpx;
  color: #DDD;
  margin: 0 8rpx;
}

.rating-star.star-on {
  color: #FFA502;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}
