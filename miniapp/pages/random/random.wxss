/**
 * 随机选餐（跑马灯）样式
 * 核心特色功能
 */

.page-random {
  min-height: 100vh;
  background: linear-gradient(180deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

/* ===== 头部 ===== */
.random-header {
  text-align: center;
  padding: 48rpx 32rpx 32rpx;
}

.random-header__title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFD700;
  display: block;
  margin-bottom: 12rpx;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
}

.random-header__desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 跑马灯舞台 ===== */
.marquee-stage {
  width: 620rpx;
  margin-top: 20rpx;
}

/* 装饰灯带 */
.stage-decoration {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}

.light-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #FFD700;
  animation: light-blink 0.5s infinite alternate;
}

.light-dot:nth-child(2n) {
  animation-delay: 0.2s;
}

.light-dot:nth-child(3n) {
  animation-delay: 0.4s;
}

.light-dot:nth-child(5n) {
  background-color: #FF4757;
}

@keyframes light-blink {
  from { opacity: 0.3; transform: scale(0.8); }
  to   { opacity: 1;   transform: scale(1.2); }
}

/* 跑马灯卡片 */
.marquee-card {
  width: 100%;
  height: 600rpx;
  background: linear-gradient(145deg, #1E2A4A, #1A2540);
  border-radius: 24rpx;
  border: 3rpx solid rgba(255, 215, 0, 0.3);
  box-shadow:
    0 0 40rpx rgba(255, 107, 53, 0.2),
    inset 0 0 60rpx rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.marquee-card--running {
  border-color: rgba(255, 107, 53, 0.6);
  box-shadow:
    0 0 60rpx rgba(255, 107, 53, 0.4),
    0 0 120rpx rgba(255, 71, 87, 0.2),
    inset 0 0 60rpx rgba(0, 0, 0, 0.3);
  animation: card-pulse 0.3s infinite alternate;
}

@keyframes card-pulse {
  from { border-color: rgba(255, 107, 53, 0.6); }
  to   { border-color: rgba(255, 215, 0, 0.9); }
}

.marquee-card--stopped {
  border-color: rgba(46, 213, 115, 0.8);
  box-shadow:
    0 0 60rpx rgba(46, 213, 115, 0.3),
    inset 0 0 60rpx rgba(0, 0, 0, 0.3);
}

/* 空闲状态 */
.marquee-idle {
  text-align: center;
}

.idle-emoji {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
  animation: idle-float 2s ease-in-out infinite;
}

@keyframes idle-float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-16rpx); }
}

.idle-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  margin-bottom: 8rpx;
}

/* 跑马灯菜品显示 */
.marquee-dish {
  text-align: center;
  padding: 40rpx;
}

.marquee-dish--rolling {
  animation: dish-flash 0.08s infinite;
}

@keyframes dish-flash {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.7; }
}

.marquee-dish__image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.05);
  display: block;
  margin: 0 auto 32rpx;
}

.marquee-dish__info {
  text-align: center;
}

.marquee-dish__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.marquee-dish__category {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background-color: rgba(255, 255, 255, 0.08);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}

.marquee-dish__price {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFD700;
  display: block;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.4);
}

/* 停止结果遮罩 */
.marquee-result-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(46, 213, 115, 0.15), rgba(46, 213, 115, 0.05));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: mask-in 0.4s ease-out;
}

@keyframes mask-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.result-emoji {
  font-size: 80rpx;
  animation: result-bounce 0.5s ease-out;
}

@keyframes result-bounce {
  0%   { transform: scale(0); }
  50%  { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.result-label {
  font-size: 36rpx;
  font-weight: 700;
  color: #2ED573;
  margin-top: 16rpx;
  text-shadow: 0 0 20rpx rgba(46, 213, 115, 0.4);
}

/* 速度指示器 */
.speed-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  gap: 8rpx;
}

.speed-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #FF6B35;
  animation: speed-blink 0.3s infinite alternate;
}

.speed-dot--fast {
  animation-duration: 0.15s;
}

.speed-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: 12rpx;
}

@keyframes speed-blink {
  from { opacity: 0.2; }
  to   { opacity: 1; }
}

/* ===== 控制按钮 ===== */
.marquee-controls {
  margin-top: 48rpx;
  width: 560rpx;
}

.ctrl-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.ctrl-btn::after {
  border: none;
}

.ctrl-btn__icon {
  font-size: 40rpx;
  margin-right: 14rpx;
}

.ctrl-btn__text {
  font-size: 34rpx;
}

/* 开始按钮 */
.ctrl-btn--start {
  background: linear-gradient(135deg, #FF6B35, #FF4757);
  color: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.4);
  animation: btn-glow 2s infinite;
}

@keyframes btn-glow {
  0%, 100% { box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.4); }
  50%      { box-shadow: 0 8rpx 50rpx rgba(255, 107, 53, 0.7); }
}

.ctrl-btn--start:active {
  transform: scale(0.95);
}

.ctrl-btn--start[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.3);
  box-shadow: none;
  animation: none;
}

/* 停止按钮 */
.ctrl-btn--stop {
  background: linear-gradient(135deg, #FF4757, #FF0068);
  color: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(255, 71, 87, 0.5);
  animation: stop-pulse 0.5s infinite alternate;
}

@keyframes stop-pulse {
  from { transform: scale(1); }
  to   { transform: scale(1.03); }
}

.ctrl-btn--stop:active {
  transform: scale(0.93);
}

/* 结果按钮组 */
.ctrl-result-actions {
  display: flex;
  gap: 24rpx;
}

.ctrl-btn--confirm {
  flex: 1;
  background: linear-gradient(135deg, #2ED573, #1DB954);
  color: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(46, 213, 115, 0.4);
  height: 100rpx;
  border-radius: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-btn--retry {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 确认弹窗 ===== */
.confirm-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.confirm-card {
  background-color: #1E2A4A;
  border-radius: 24rpx;
  padding: 56rpx 44rpx;
  text-align: center;
  margin: 0 48rpx;
  width: 540rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.confirm-emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.confirm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.confirm-dish {
  font-size: 36rpx;
  color: #FFD700;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.confirm-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  margin-bottom: 40rpx;
}

.confirm-btns {
  width: 100%;
}

.confirm-btns .btn-outline {
  color: rgba(255, 255, 255, 0.7) !important;
  border-color: rgba(255, 255, 255, 0.3) !important;
  background: transparent !important;
}

.confirm-btns .btn-primary {
  background: linear-gradient(135deg, #FF6B35, #FF4757) !important;
}

/* 菜品池状态 */
.pool-status {
  margin-top: 32rpx;
  padding: 0 48rpx;
  text-align: center;
}
